# Public origin printed on short links.
# PUBLIC_ORIGIN=https://links.example.com

# Optional. If set on first boot, this becomes the password.
# If PUBLIC_ORIGIN is also set, onboarding is skipped.
# ADMIN_PASSWORD=

# Optional. Auto-generated and stored in data/.session_secret if omitted.
# SESSION_SECRET=generate-a-long-random-string

# Set true when Nginx Proxy Manager (or any HTTPS reverse proxy) is in front.
# Also implied when PUBLIC_ORIGIN starts with https://
# HTTPS_ONLY=true

# IPs allowed to send X-Forwarded-* headers. Default is 127.0.0.1.
# Use * when Nginx Proxy Manager is a separate container (it is not 127.0.0.1).
# FORWARDED_ALLOW_IPS=*
